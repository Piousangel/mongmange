# apps/server 환경 변수(이름과 로컬 예시만 — 실제 값은 커밋하지 않는다).
# 서버는 .env 파일을 읽지 않는다. 로컬 셸: `set -a; . apps/server/.env; set +a` 또는 compose.yaml의 environment.
# 운영(B6): Cloud Run 환경 변수 + Secret Manager. 검증 규칙은 src/config/env.ts(운영 필수값은 거기서 막는다)

NODE_ENV=development
PORT=8080
# 런타임: Supabase 트랜잭션 풀러(6543). 로컬 compose: 비슈퍼유저 prisma 롤(prisma/local/00-roles.sql)
DATABASE_URL=postgresql://prisma:prisma-local@localhost:54329/mong
# 마이그레이션 전용(필수 — 없으면 prisma migrate가 실패): Supabase 세션 풀러(5432) 또는 직접 연결. 6543이면 거부
DIRECT_URL=postgresql://prisma:prisma-local@localhost:54329/mong
DB_POOL_MAX=5
# 풀 연결 제한 시간 < READY_TIMEOUT_MS
DB_CONNECT_TIMEOUT_MS=1500
DB_STATEMENT_TIMEOUT_MS=5000
# 클라이언트 쪽 쿼리 제한 시간(네트워크 멈춤에도 걸림, statement_timeout보다 길게 — B7a)
DB_QUERY_TIMEOUT_MS=6000
READY_TIMEOUT_MS=2000
READY_CACHE_MS=2000
# /readyz 내부 토큰(헤더 x-ready-token). 운영 필수(16자 이상). 비우면 개발에서 열림
READY_TOKEN=
LOG_LEVEL=info
LOG_PRETTY=true
OPENAPI_UI=true
# 경로 그룹별 믿을 프록시 수. 0 = X-Forwarded-For 무시(로컬). 운영 필수 1 이상 — API(앱 직접) / WEB(/m/**, Firebase 경유) [B6에서 실측]
TRUSTED_PROXY_HOPS_API=0
TRUSTED_PROXY_HOPS_WEB=0
# /m/** 직접 호출 막기: off|log|enforce(비우면 운영 log·그 밖 off — B6 실측 뒤 enforce, B7a)
WEB_EDGE_CHECK=off
RATE_LIMIT_PER_MIN=120
# 전역 리밋 저장소 키 상한(LRU, 키 하나 약 170B — B7a)
RATE_LIMIT_MAX_KEYS=100000
APP_VERSION=dev
