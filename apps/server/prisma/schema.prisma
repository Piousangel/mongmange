// 몽망이 서버 DB(architecture.md v2.2 3-1). 스키마 `app`(Data API 비노출, RLS 켜고 정책 0개 — 권한 판단은 Nest).
// B1 골격(users·creatures·saves) → B0 집계 → B2 맡겨 두기(user_auth·save_versions·deletion_log·storage_gc·auth_gc, 되찾기 열).
// 나머지 표(public_pages·reports·link_daily 등)는 해당 B 항목에서 새 마이그레이션으로 만든다(확장 → 배포 → 축소).
// Prisma가 표현하지 못하는 것(부분 UNIQUE·솎기 함수·RLS)은 마이그레이션 SQL에만 있다 — test/db.db.test.ts가 고정한다.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
  schemas  = ["app"]
}

/// 익명 계정(= Supabase auth.users.id). 이름·이메일 없음. 연령은 '14세 이상 확인을 거쳤다'는 기록만(3-3)
model User {
  id               String    @id @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 그달 1일(5-5 장기 미사용 판단용, 월 단위)
  lastActiveMonth  DateTime? @map("last_active_month") @db.Date
  locale           String?   @db.Char(2)
  ageGateV         Int?      @map("age_gate_v") @db.SmallInt
  ageConfirmedOn   DateTime? @map("age_confirmed_on") @db.Date
  creature         Creature?
  auths            UserAuth[]

  @@map("users")
  @@schema("app")
}

/// 몽망이 한 마리. 인장 코드 = 링크 키(서버 난수 40비트, 3-5). 링크·이름 공개는 기본 꺼짐
model Creature {
  id          String   @id @default(uuid()) @db.Uuid
  /// 사용자당 몽망이 하나(서버 v2 리뷰: DB 제약으로 둔다)
  userId      String   @unique @map("user_id") @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code        String   @unique @db.Char(8)
  linkEnabled Boolean  @default(false) @map("link_enabled")
  nameVisible Boolean  @default(false) @map("name_visible")
  hidden      Boolean  @default(false)
  /// 되찾기 글귀 해시(HMAC-SHA256(pepper, 글귀), 3-3 ⑤). 평문은 어디에도 없다. 되찾으면 새 글귀로 바뀐다
  recoveryHash      Bytes?    @unique @map("recovery_hash")
  recoveryPepperV   Int?      @map("recovery_pepper_v") @db.SmallInt
  recoveryRotatedAt DateTime? @map("recovery_rotated_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  save        Save?
  versions    SaveVersion[]
  page        PublicPage?

  @@map("creatures")
  @@schema("app")
}

/// 현재 세이브 한 벌(통째 스냅샷 + 리비전, 3-4). 본문은 gzip bytea, 서버는 아래 몇 열 말고는 본문에서 꺼내지 않는다(5-1)
model Save {
  creatureId    String   @id @map("creature_id") @db.Uuid
  creature      Creature @relation(fields: [creatureId], references: [id], onDelete: Cascade)
  rev           Int
  body          Bytes
  bodySha256    Bytes    @map("body_sha256")
  envelopeVer   Int      @map("envelope_ver") @db.SmallInt
  simVer        Int      @map("sim_ver") @db.SmallInt
  validated     Boolean
  clientSavedAt DateTime @map("client_saved_at") @db.Timestamptz(6)
  /// 미래 판 본(validated=false)은 서버가 읽지 못해 NULL(3-4-1)
  dayIndex      Int?     @map("day_index")
  strokesTotal  Int?     @map("strokes_total")
  /// 하루(UTC) 새 본문 바이트 상한(3-4-1 '남용 상한' 4MB/일)의 셈 — 날짜와 그날 합(압축 뒤)
  quotaDay      DateTime? @map("quota_day") @db.Date
  quotaBytes    Int       @default(0) @map("quota_bytes")
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("saves")
  @@schema("app")
}

/// 기기 로그인(JWT sub) → 사용자(3-1, B2). 되찾기는 새 기기 sub를 붙이고 옛 sub를 revoked로(3-3 ⑤).
/// 쓰는 기기는 하나: UNIQUE(user_id) WHERE revoked_at IS NULL — 부분 인덱스라 마이그레이션 SQL에만 있다.
model UserAuth {
  sub       String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkedAt  DateTime  @default(now()) @map("linked_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([linkedAt])
  @@map("user_auth")
  @@schema("app")
}

enum SaveVersionReason {
  overwritten
  weekly
  conflict
  pre_restore

  @@map("save_version_reason")
  @@schema("app")
}

/// 세이브 이력(3-4-1): 최근 3벌(overwritten) + 주 1벌(weekly) 최대 28일, 충돌·복원 전 본 각 3벌 30일.
/// API에는 public_id만 내보낸다(순번이 규모를 드러내지 않게). UNIQUE(creature_id, iso_week) WHERE reason='weekly'는 SQL에만.
model SaveVersion {
  id            BigInt            @id @default(autoincrement())
  publicId      String            @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  creatureId    String            @map("creature_id") @db.Uuid
  creature      Creature          @relation(fields: [creatureId], references: [id], onDelete: Cascade)
  rev           Int
  body          Bytes
  bodySha256    Bytes             @map("body_sha256")
  envelopeVer   Int               @map("envelope_ver") @db.SmallInt
  simVer        Int               @map("sim_ver") @db.SmallInt
  validated     Boolean
  dayIndex      Int?              @map("day_index")
  strokesTotal  Int?              @map("strokes_total")
  clientSavedAt DateTime          @map("client_saved_at") @db.Timestamptz(6)
  reason        SaveVersionReason
  /// weekly만, 예 `2026-W52`(서버 UTC ISO 주)
  isoWeek       String?           @map("iso_week") @db.Char(8)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([creatureId, reason, createdAt(sort: Desc)])
  @@index([createdAt])
  @@map("save_versions")
  @@schema("app")
}

enum DeletionChannel {
  app
  web
  email

  @@map("deletion_channel")
  @@schema("app")
}

enum DeletionKind {
  user_request
  web_request
  inactive
  report_confirmed
  /// 백업 복원 뒤 이미 지웠던 계정을 다시 지움(3-8 '백업', B2 리뷰 m2)
  restore_reapply

  @@map("deletion_kind")
  @@schema("app")
}

/// 삭제 기록(3-8). 누구인지 없이 개수만. 영수증은 해시만, 24시간 뒤 NULL
model DeletionLog {
  id               BigInt          @id @default(autoincrement())
  requestedAt      DateTime        @default(now()) @map("requested_at") @db.Timestamptz(6)
  completedAt      DateTime?       @map("completed_at") @db.Timestamptz(6)
  channel          DeletionChannel
  kind             DeletionKind
  items            Json
  receiptHash      Bytes?          @map("receipt_hash")
  receiptExpiresAt DateTime?       @map("receipt_expires_at") @db.Timestamptz(6)
  /// 지운 사용자 id의 단방향 HMAC(pepper 파생 키). 백업 보관 기간(7일)만 — 복원 뒤 다시 지울 근거. 그 뒤 NULL
  subjectHmac      Bytes?          @map("subject_hmac")
  subjectExpiresAt DateTime?       @map("subject_expires_at") @db.Timestamptz(6)

  @@index([receiptHash])
  @@index([subjectHmac])
  @@map("deletion_log")
  @@schema("app")
}

enum StorageGcReason {
  old_version
  uncommitted
  quarantine_expiry
  deletion
  /// 공개 → quarantine 이동 대기(B3 리뷰 M5 — 일부만 옮겨지면 대기열이 다시 시도)
  quarantine_move

  @@map("storage_gc_reason")
  @@schema("app")
}

/// Storage 삭제 대기열(3-1). creature_id는 FK가 아니다 — 계정 삭제 뒤에도 남은 항목을 찾으려고. 처리하면 행째 지운다
model StorageGc {
  id         BigInt          @id @default(autoincrement())
  bucket     String          @db.VarChar(32)
  prefix     String
  creatureId String?         @map("creature_id") @db.Uuid
  /// 계정 삭제가 만든 항목이면 그 deletion_log — 전부 지워지면 영수증이 done(3-8 ⑥)
  deletionId BigInt?         @map("deletion_id")
  reason     StorageGcReason
  notBefore  DateTime        @map("not_before") @db.Timestamptz(6)
  attempts   Int             @default(0) @db.SmallInt

  @@index([notBefore])
  @@index([creatureId])
  @@index([deletionId])
  @@map("storage_gc")
  @@schema("app")
}

/// Supabase auth.users 삭제 대기열(3-8 ⑤ '실패하면 재시도', 3-3 ⑤ 옛 기기 30일). 지워지면 행째 지운다.
/// sub 말고는 아무것도 없다 — users·user_auth가 이미 사라진 뒤에 남는 유일한 흔적이라 처리되는 즉시 없어진다
model AuthGc {
  sub        String    @id @db.Uuid
  deletionId BigInt?   @map("deletion_id")
  notBefore  DateTime  @map("not_before") @db.Timestamptz(6)
  attempts   Int       @default(0) @db.SmallInt

  @@index([notBefore])
  @@index([deletionId])
  @@map("auth_gc")
  @@schema("app")
}

/// 식별자 없는 집계(architecture.md v2.1 3-1·3-6, B0). 사람·기기·IP·시각 열이 **없다** — 칸(날짜·차원)과 개수뿐.
/// day = 그 이벤트가 일어난 현지 날짜(= cohort_day + day_n). 90일 뒤 월 단위로 말기(5-5)는 pg_cron(B6 이후).
/// 열 목록은 test/db.db.test.ts가 고정한다(열을 더하면 처리방침 3-1을 함께 고쳐야 한다).
model MetricDaily {
  day       DateTime @db.Date
  event     String   @db.VarChar(16)
  cohortDay DateTime @map("cohort_day") @db.Date
  dayN      Int      @map("day_n") @db.SmallInt
  platform  String   @db.VarChar(8)
  appVer    String   @map("app_ver") @db.VarChar(24)
  lang      String   @db.Char(2)
  /// 이름 시점 군 A·B
  nt        String   @db.Char(1)
  /// 7일째 위젯 1·0, 그 전 '-'
  wg        String   @db.Char(1)
  /// 보름 창 1·0
  moon      String   @db.Char(1)
  count     Int

  @@id([day, event, cohortDay, dayN, platform, appVer, lang, nt, wg, moon])
  @@map("metric_daily")
  @@schema("app")
}

/// 90일 지난 집계를 월 단위로 만 것(처리방침 6절 '90일 뒤 월 합계', B0 리뷰 반영). 날짜·보름·위젯 칸을 버려 더 굵다.
/// app.rollup_metric_daily()가 metric_daily에서 옮긴다(삭제와 삽입이 한 문장). 실행 예약(pg_cron 매일)은 B6.
model MetricMonthly {
  month       DateTime @db.Date
  cohortMonth DateTime @map("cohort_month") @db.Date
  event       String   @db.VarChar(16)
  dayN        Int      @map("day_n") @db.SmallInt
  platform    String   @db.VarChar(8)
  appVer      String   @map("app_ver") @db.VarChar(24)
  lang        String   @db.Char(2)
  nt          String   @db.Char(1)
  count       Int

  @@id([month, cohortMonth, event, dayN, platform, appVer, lang, nt])
  @@map("metric_monthly")
  @@schema("app")
}

enum PageState {
  live
  off
  quarantined
  removed

  @@map("page_state")
  @@schema("app")
}

/// 공개 사본(3-1·3-5·3-5-3, B3). 몽망이마다 하나. 공개 값은 링크를 켤 때(또는 다시 만들기 때) 고정된다.
/// path_prefix·pending_prefix = 불투명 pageKey(서버 난수, 코드에서 파생하지 않음). CHECK(live면 경로 있음·pending 칸 함께)는 SQL에만
model PublicPage {
  creatureId       String    @id @map("creature_id") @db.Uuid
  creature         Creature  @relation(fields: [creatureId], references: [id], onDelete: Cascade)
  /// 몽망이별 저장소 접두(서버 난수, 16진 32자). 파일 = {storeKey}/{pageKey}/파일 — 계정 삭제가 이 접두로 세 버킷을 훑는다
  storeKey         String    @unique @default(dbgenerated("replace((gen_random_uuid())::text, '-'::text, ''::text)")) @map("store_key")
  ver              Int       @default(0)
  state            PageState @default(off)
  /// {snap:1, name?, ink, texture?, bornDate, dayAtPublish, lang} — HTML 한 줄·title·og:title에만
  meta             Json?
  nameShown        Boolean   @default(false) @map("name_shown")
  pathPrefix       String?   @map("path_prefix")
  hasLoop          Boolean   @default(false) @map("has_loop")
  publishedAt      DateTime? @map("published_at") @db.Timestamptz(6)
  stateChangedAt   DateTime  @default(now()) @map("state_changed_at") @db.Timestamptz(6)
  pendingVer       Int?      @map("pending_ver")
  pendingPrefix    String?   @map("pending_prefix")
  pendingMeta      Json?     @map("pending_meta")
  pendingNameShown Boolean?  @map("pending_name_shown")
  pendingHasLoop   Boolean?  @map("pending_has_loop")

  @@index([state])
  @@map("public_pages")
  @@schema("app")
}

enum LinkEvent {
  view
  store_ios
  store_android
  open_app

  @@map("link_event")
  @@schema("app")
}

/// 링크별 하루 합계(3-6 '링크 퍼널'). IP·UA·시각 없음. 30일 뒤 app.rollup_link_daily()가 코드 없는 합계로 만다. 계정 삭제 때 그 코드 행 즉시 삭제
model LinkDaily {
  day   DateTime  @db.Date
  code  String    @db.Char(8)
  event LinkEvent
  count Int

  @@id([day, code, event])
  @@index([code])
  @@map("link_daily")
  @@schema("app")
}

/// 코드 없는 링크 퍼널 합계
model LinkFunnelDaily {
  day   DateTime  @db.Date
  event LinkEvent
  count Int

  @@id([day, event])
  @@map("link_funnel_daily")
  @@schema("app")
}

/// /m HTML CDN 무효화 대기(3-9). 한 행뿐 — 무엇을 지울지(코드·경로)를 담지 않는다(Firebase 새 릴리스 = 사이트 전체).
/// requested_at이 있으면 대기 중, released_at = 마지막 릴리스(1분 묶음의 기준)
model CdnPurge {
  id          Int       @id @default(1) @db.SmallInt
  requestedAt DateTime? @map("requested_at") @db.Timestamptz(6)
  releasedAt  DateTime? @map("released_at") @db.Timestamptz(6)
  attempts    Int       @default(0) @db.SmallInt

  @@map("cdn_purge")
  @@schema("app")
}
