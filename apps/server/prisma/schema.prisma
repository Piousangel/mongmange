// 몽망이 서버 DB(architecture.md v2.2 3-1). 스키마 `app`(Data API 비노출, RLS 켜고 정책 0개 — 권한 판단은 Nest).
// B1 골격(users·creatures·saves) → B0 집계 → B2 맡겨 두기(user_auth·save_versions·deletion_log·storage_gc·auth_gc, 되찾기 열).
// 나머지 표(public_pages·reports·link_daily 등)는 해당 B 항목에서 새 마이그레이션으로 만든다(확장 → 배포 → 축소).
// Prisma가 표현하지 못하는 것(부분 UNIQUE·솎기 함수·RLS)은 마이그레이션 SQL에만 있다 — test/db.db.test.ts가 고정한다.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
  schemas  = ["app"]
}

/// 익명 계정(= Supabase auth.users.id). 이름·이메일 없음. 연령은 '14세 이상 확인을 거쳤다'는 기록만(3-3)
model User {
  id                String     @id @db.Uuid
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 그달 1일(5-5 장기 미사용 판단용, 월 단위)
  lastActiveMonth   DateTime?  @map("last_active_month") @db.Date
  locale            String?    @db.Char(2)
  ageGateV          Int?       @map("age_gate_v") @db.SmallInt
  ageConfirmedOn    DateTime?  @map("age_confirmed_on") @db.Date
  /// 운영자 계정 삭제 요청(B5, docs/ops/deletion-requests.md). 72시간 대기 뒤 서버 작업 moderation이 DELETE /me와 같은 연쇄로 지운다
  deleteRequestedAt DateTime?  @map("delete_requested_at") @db.Timestamptz(6)
  creature          Creature?
  auths             UserAuth[]

  @@map("users")
  @@schema("app")
}

/// 몽망이 한 마리. 인장 코드 = 링크 키(서버 난수 40비트, 3-5). 링크·이름 공개는 기본 꺼짐
model Creature {
  id                String        @id @default(uuid()) @db.Uuid
  /// 사용자당 몽망이 하나(서버 v2 리뷰: DB 제약으로 둔다)
  userId            String        @unique @map("user_id") @db.Uuid
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  code              String        @unique @db.Char(8)
  linkEnabled       Boolean       @default(false) @map("link_enabled")
  nameVisible       Boolean       @default(false) @map("name_visible")
  hidden            Boolean       @default(false)
  /// 운영자 이름 가리기(B5, 3-5-2). 켜지면 공개 판정은 늘 거짓, 주인은 이름 공개를 다시 켤 수 없다(409). 해제는 운영자 SQL 함수만
  nameBlocked       Boolean       @default(false) @map("name_blocked")
  /// 되찾기 글귀 해시(HMAC-SHA256(pepper, 글귀), 3-3 ⑤). 평문은 어디에도 없다. 되찾으면 새 글귀로 바뀐다
  recoveryHash      Bytes?        @unique @map("recovery_hash")
  recoveryPepperV   Int?          @map("recovery_pepper_v") @db.SmallInt
  recoveryRotatedAt DateTime?     @map("recovery_rotated_at") @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  save              Save?
  versions          SaveVersion[]
  page              PublicPage?

  @@map("creatures")
  @@schema("app")
}

/// 현재 세이브 한 벌(통째 스냅샷 + 리비전, 3-4). 본문은 gzip bytea, 서버는 아래 몇 열 말고는 본문에서 꺼내지 않는다(5-1)
model Save {
  creatureId    String    @id @map("creature_id") @db.Uuid
  creature      Creature  @relation(fields: [creatureId], references: [id], onDelete: Cascade)
  rev           Int
  body          Bytes
  bodySha256    Bytes     @map("body_sha256")
  envelopeVer   Int       @map("envelope_ver") @db.SmallInt
  simVer        Int       @map("sim_ver") @db.SmallInt
  validated     Boolean
  clientSavedAt DateTime  @map("client_saved_at") @db.Timestamptz(6)
  /// 미래 판 본(validated=false)은 서버가 읽지 못해 NULL(3-4-1)
  dayIndex      Int?      @map("day_index")
  strokesTotal  Int?      @map("strokes_total")
  /// 하루(UTC) 새 본문 바이트 상한(3-4-1 '남용 상한' 4MB/일)의 셈 — 날짜와 그날 합(압축 뒤)
  quotaDay      DateTime? @map("quota_day") @db.Date
  quotaBytes    Int       @default(0) @map("quota_bytes")
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("saves")
  @@schema("app")
}

/// 기기 로그인(JWT sub) → 사용자(3-1, B2). 되찾기는 새 기기 sub를 붙이고 옛 sub를 revoked로(3-3 ⑤).
/// 쓰는 기기는 하나: UNIQUE(user_id) WHERE revoked_at IS NULL — 부분 인덱스라 마이그레이션 SQL에만 있다.
model UserAuth {
  sub       String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkedAt  DateTime  @default(now()) @map("linked_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([linkedAt])
  @@map("user_auth")
  @@schema("app")
}

enum SaveVersionReason {
  overwritten
  weekly
  conflict
  pre_restore

  @@map("save_version_reason")
  @@schema("app")
}

/// 세이브 이력(3-4-1): 최근 3벌(overwritten) + 주 1벌(weekly) 최대 28일, 충돌·복원 전 본 각 3벌 30일.
/// API에는 public_id만 내보낸다(순번이 규모를 드러내지 않게). UNIQUE(creature_id, iso_week) WHERE reason='weekly'는 SQL에만.
model SaveVersion {
  id            BigInt            @id @default(autoincrement())
  publicId      String            @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  creatureId    String            @map("creature_id") @db.Uuid
  creature      Creature          @relation(fields: [creatureId], references: [id], onDelete: Cascade)
  rev           Int
  body          Bytes
  bodySha256    Bytes             @map("body_sha256")
  envelopeVer   Int               @map("envelope_ver") @db.SmallInt
  simVer        Int               @map("sim_ver") @db.SmallInt
  validated     Boolean
  dayIndex      Int?              @map("day_index")
  strokesTotal  Int?              @map("strokes_total")
  clientSavedAt DateTime          @map("client_saved_at") @db.Timestamptz(6)
  reason        SaveVersionReason
  /// weekly만, 예 `2026-W52`(서버 UTC ISO 주)
  isoWeek       String?           @map("iso_week") @db.Char(8)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([creatureId, reason, createdAt(sort: Desc)])
  @@index([createdAt])
  @@map("save_versions")
  @@schema("app")
}

enum DeletionChannel {
  app
  web
  email

  @@map("deletion_channel")
  @@schema("app")
}

enum DeletionKind {
  user_request
  web_request
  inactive
  report_confirmed
  /// 백업 복원 뒤 이미 지웠던 계정을 다시 지움(3-8 '백업', B2 리뷰 m2)
  restore_reapply

  @@map("deletion_kind")
  @@schema("app")
}

/// 삭제 기록(3-8). 누구인지 없이 개수만. 영수증은 해시만, 24시간 뒤 NULL
model DeletionLog {
  id               BigInt          @id @default(autoincrement())
  requestedAt      DateTime        @default(now()) @map("requested_at") @db.Timestamptz(6)
  completedAt      DateTime?       @map("completed_at") @db.Timestamptz(6)
  channel          DeletionChannel
  kind             DeletionKind
  items            Json
  receiptHash      Bytes?          @map("receipt_hash")
  receiptExpiresAt DateTime?       @map("receipt_expires_at") @db.Timestamptz(6)
  /// 지운 사용자 id의 단방향 HMAC(pepper 파생 키). 백업 보관 기간(7일)만 — 복원 뒤 다시 지울 근거. 그 뒤 NULL
  subjectHmac      Bytes?          @map("subject_hmac")
  subjectExpiresAt DateTime?       @map("subject_expires_at") @db.Timestamptz(6)

  @@index([receiptHash])
  @@index([subjectHmac])
  @@map("deletion_log")
  @@schema("app")
}

enum StorageGcReason {
  old_version
  uncommitted
  quarantine_expiry
  deletion
  /// 공개 → quarantine 이동 대기(B3 리뷰 M5 — 일부만 옮겨지면 대기열이 다시 시도)
  quarantine_move
  /// quarantine → 공개 되돌리기(B5 운영자 복원 — 다 옮기면 live)
  restore_move
  /// 이름 뺀 판 다시 쓰기(B5 운영자 이름 가리기 — 새 pageKey에 포스터·루프·이름 없는 snap.json, 옛 경로 삭제)
  name_mask

  @@map("storage_gc_reason")
  @@schema("app")
}

/// Storage 삭제 대기열(3-1). creature_id는 FK가 아니다 — 계정 삭제 뒤에도 남은 항목을 찾으려고. 처리하면 행째 지운다
model StorageGc {
  id         BigInt          @id @default(autoincrement())
  bucket     String          @db.VarChar(32)
  prefix     String
  creatureId String?         @map("creature_id") @db.Uuid
  /// 계정 삭제가 만든 항목이면 그 deletion_log — 전부 지워지면 영수증이 done(3-8 ⑥)
  deletionId BigInt?         @map("deletion_id")
  reason     StorageGcReason
  notBefore  DateTime        @map("not_before") @db.Timestamptz(6)
  attempts   Int             @default(0) @db.SmallInt

  @@index([notBefore])
  @@index([creatureId])
  @@index([deletionId])
  @@map("storage_gc")
  @@schema("app")
}

/// Supabase auth.users 삭제 대기열(3-8 ⑤ '실패하면 재시도', 3-3 ⑤ 옛 기기 30일). 지워지면 행째 지운다.
/// sub 말고는 아무것도 없다 — users·user_auth가 이미 사라진 뒤에 남는 유일한 흔적이라 처리되는 즉시 없어진다
model AuthGc {
  sub        String   @id @db.Uuid
  deletionId BigInt?  @map("deletion_id")
  notBefore  DateTime @map("not_before") @db.Timestamptz(6)
  attempts   Int      @default(0) @db.SmallInt

  @@index([notBefore])
  @@index([deletionId])
  @@map("auth_gc")
  @@schema("app")
}

/// 식별자 없는 집계(architecture.md v2.1 3-1·3-6, B0). 사람·기기·IP·시각 열이 **없다** — 칸(날짜·차원)과 개수뿐.
/// day = 그 이벤트가 일어난 현지 날짜(= cohort_day + day_n). 90일 뒤 월 단위로 말기(5-5)는 pg_cron(B6 이후).
/// 열 목록은 test/db.db.test.ts가 고정한다(열을 더하면 처리방침 3-1을 함께 고쳐야 한다).
model MetricDaily {
  day       DateTime @db.Date
  event     String   @db.VarChar(16)
  cohortDay DateTime @map("cohort_day") @db.Date
  dayN      Int      @map("day_n") @db.SmallInt
  platform  String   @db.VarChar(8)
  appVer    String   @map("app_ver") @db.VarChar(24)
  lang      String   @db.Char(2)
  /// 이름 시점 군 A·B
  nt        String   @db.Char(1)
  /// 7일째 위젯 1·0, 그 전 '-'
  wg        String   @db.Char(1)
  /// 보름 창 1·0
  moon      String   @db.Char(1)
  count     Int

  @@id([day, event, cohortDay, dayN, platform, appVer, lang, nt, wg, moon])
  @@map("metric_daily")
  @@schema("app")
}

/// 90일 지난 집계를 월 단위로 만 것(처리방침 6절 '90일 뒤 월 합계', B0 리뷰 반영). 날짜·보름·위젯 칸을 버려 더 굵다.
/// app.rollup_metric_daily()가 metric_daily에서 옮긴다(삭제와 삽입이 한 문장). 실행 예약(pg_cron 매일)은 B6.
model MetricMonthly {
  month       DateTime @db.Date
  cohortMonth DateTime @map("cohort_month") @db.Date
  event       String   @db.VarChar(16)
  dayN        Int      @map("day_n") @db.SmallInt
  platform    String   @db.VarChar(8)
  appVer      String   @map("app_ver") @db.VarChar(24)
  lang        String   @db.Char(2)
  nt          String   @db.Char(1)
  count       Int

  @@id([month, cohortMonth, event, dayN, platform, appVer, lang, nt])
  @@map("metric_monthly")
  @@schema("app")
}

enum PageState {
  live
  off
  quarantined
  removed

  @@map("page_state")
  @@schema("app")
}

/// 공개 사본(3-1·3-5·3-5-3, B3). 몽망이마다 하나. 공개 값은 링크를 켤 때(또는 다시 만들기 때) 고정된다.
/// path_prefix·pending_prefix = 불투명 pageKey(서버 난수, 코드에서 파생하지 않음). CHECK(live면 경로 있음·pending 칸 함께)는 SQL에만
model PublicPage {
  creatureId       String    @id @map("creature_id") @db.Uuid
  creature         Creature  @relation(fields: [creatureId], references: [id], onDelete: Cascade)
  /// 몽망이별 저장소 접두(서버 난수, 16진 32자). 파일 = {storeKey}/{pageKey}/파일 — 계정 삭제가 이 접두로 세 버킷을 훑는다
  storeKey         String    @unique @default(dbgenerated("replace((gen_random_uuid())::text, '-'::text, ''::text)")) @map("store_key")
  ver              Int       @default(0)
  state            PageState @default(off)
  /// {snap:1, name?, ink, texture?, bornDate, dayAtPublish, lang} — HTML 한 줄·title·og:title에만
  meta             Json?
  nameShown        Boolean   @default(false) @map("name_shown")
  pathPrefix       String?   @map("path_prefix")
  hasLoop          Boolean   @default(false) @map("has_loop")
  publishedAt      DateTime? @map("published_at") @db.Timestamptz(6)
  stateChangedAt   DateTime  @default(now()) @map("state_changed_at") @db.Timestamptz(6)
  pendingVer       Int?      @map("pending_ver")
  pendingPrefix    String?   @map("pending_prefix")
  pendingMeta      Json?     @map("pending_meta")
  pendingNameShown Boolean?  @map("pending_name_shown")
  pendingHasLoop   Boolean?  @map("pending_has_loop")

  @@index([state])
  @@map("public_pages")
  @@schema("app")
}

enum LinkEvent {
  view
  store_ios
  store_android
  open_app

  @@map("link_event")
  @@schema("app")
}

/// 링크별 하루 합계(3-6 '링크 퍼널'). IP·UA·시각 없음. 30일 뒤 app.rollup_link_daily()가 코드 없는 합계로 만다. 계정 삭제 때 그 코드 행 즉시 삭제
model LinkDaily {
  day   DateTime  @db.Date
  code  String    @db.Char(8)
  event LinkEvent
  count Int

  @@id([day, code, event])
  @@index([code])
  @@map("link_daily")
  @@schema("app")
}

/// 코드 없는 링크 퍼널 합계
model LinkFunnelDaily {
  day   DateTime  @db.Date
  event LinkEvent
  count Int

  @@id([day, event])
  @@map("link_funnel_daily")
  @@schema("app")
}

/// /m HTML CDN 무효화 대기(3-9). 한 행뿐 — 무엇을 지울지(코드·경로)를 담지 않는다(Firebase 새 릴리스 = 사이트 전체).
/// requested_at이 있으면 대기 중, released_at = 마지막 릴리스(1분 묶음의 기준)
model CdnPurge {
  id          Int       @id @default(1) @db.SmallInt
  requestedAt DateTime? @map("requested_at") @db.Timestamptz(6)
  releasedAt  DateTime? @map("released_at") @db.Timestamptz(6)
  attempts    Int       @default(0) @db.SmallInt

  @@map("cdn_purge")
  @@schema("app")
}

enum ReportTarget {
  link
  encounter
  cohort
  footprint

  @@map("report_target")
  @@schema("app")
}

enum ReportStatus {
  open
  auto_hidden
  expired
  restored
  confirmed
  dismissed
  /// 대상 계정이 지워져 닫힘(B5 리뷰 M2)
  account_deleted

  @@map("report_status")
  @@schema("app")
}

/// 신고(B5, 3-1·3-8). 대상마다 열린 행 하나(부분 UNIQUE — SQL에만) + 그 신고 전용 소금(열린 동안만, CHECK — SQL에만).
/// 닫히면(숨김·창 끝·운영 처리) 트리거가 report_hits를 지운다. 1년 보관(코드만 — 재발 판단)
model Report {
  id                BigInt       @id @default(autoincrement())
  targetKind        ReportTarget @map("target_kind")
  targetRef         String       @map("target_ref")
  /// 사유 코드별 개수(자유 글 없음)
  reasonCounts      Json         @default("{}") @map("reason_counts")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  windowEndsAt      DateTime     @map("window_ends_at") @db.Timestamptz(6)
  salt              Bytes?
  distinctReporters Int          @default(0) @map("distinct_reporters") @db.SmallInt
  status            ReportStatus @default(open)
  resolvedAt        DateTime?    @map("resolved_at") @db.Timestamptz(6)
  /// 자동 숨김 시각(서비스 전체 1시간 차단기)
  hiddenAt          DateTime?    @map("hidden_at") @db.Timestamptz(6)
  /// 문턱을 넘었지만 대기 목록에만: immune(최근 7일 복원)·breaker(서비스 차단기)·disabled(자동 숨김 꺼짐). CHECK는 SQL에만
  held              String?      @db.VarChar(16)
  hits              ReportHit[]

  @@index([status, windowEndsAt])
  @@index([targetRef])
  @@index([createdAt])
  @@index([hiddenAt])
  @@map("reports")
  @@schema("app")
}

/// 신고자 키 = HMAC-SHA256(reports.salt, IP 접두). 시각·UA·IP 없음
model ReportHit {
  reportId    BigInt @map("report_id")
  report      Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reporterKey Bytes  @map("reporter_key")

  @@id([reportId, reporterKey])
  @@map("report_hits")
  @@schema("app")
}

/// 운영 기록(B5 SQL 함수가 같은 트랜잭션에서 쓴다). 1년 뒤 삭제. 계정 삭제 요청에는 코드를 적지 않는다
model AdminAction {
  id         BigInt   @id @default(autoincrement())
  action     String   @db.VarChar(32)
  targetKind String   @map("target_kind") @db.VarChar(16)
  targetRef  String?  @map("target_ref")
  note       String?
  /// 실행한 DB 로그인(session_user)
  actor      String   @db.VarChar(64)
  at         DateTime @default(now()) @db.Timestamptz(6)

  @@index([at])
  @@map("admin_actions")
  @@schema("app")
}

/// 자체 OTA(V21, docs/design/server-v1/ota-self-host.md). update = 매니페스트, rollback = 내장 번들로 되돌리기 지시
enum OtaKind {
  update
  rollback

  @@map("ota_kind")
  @@schema("app")
}

/// OTA 게시 목록(사용자와 무관 — 설치 id·IP·기기 값 칸이 없다). 쓰기는 게시 롤 `ota_publisher`(INSERT만), 서버 롤은 SELECT만 —
/// FORCE RLS + 정책으로 DB가 강제한다(마이그레이션). 수정·삭제 정책은 없다(덧붙이기만).
/// body = 서명한 JSON 원문 그대로(매니페스트 또는 지시). 원문 안에 seq·channel이 서명되어 있어 서버가 행과 대조한다(리뷰 M3)
model OtaRelease {
  id             String   @id @db.Uuid
  channel        String   @db.VarChar(32)
  runtimeVersion String   @map("runtime_version") @db.VarChar(128)
  platform       String   @db.VarChar(8)
  /// 판 번호(채널·런타임·플랫폼 안에서 1부터 1씩). 서버는 가장 큰 seq를 고른다
  seq            Int
  kind           OtaKind
  /// 매니페스트 createdAt / 롤백 commitTime(앞 판보다 늘 늦다 — CLI가 확인)
  createdAt      DateTime @map("created_at") @db.Timestamptz(3)
  body           String
  /// RSA-SHA256(PKCS#1 v1.5) base64. 운영에서는 서명 없는 행을 내보내지 않는다
  signature      String?
  /// 채널별 키(preview·production)
  keyId          String?  @map("key_id") @db.VarChar(64)
  /// 이 판이 가리키는 에셋 해시(launchAsset 첫째) — 에셋 보유 확인·정리용
  assetHashes    String[] @default([]) @map("asset_hashes")
  publishedAt    DateTime @default(now()) @map("published_at") @db.Timestamptz(6)

  @@unique([channel, runtimeVersion, platform, seq])
  @@map("ota_releases")
  @@schema("app")
}

/// 롤백한 나쁜 판(launchAsset 해시 = 번들 내용). 게시 CLI는 이 번들을 다시 게시하지 않고, 서버는 행이 있어도 내보내지 않는다
model OtaRevoked {
  launchHash String   @id @map("launch_hash") @db.VarChar(43)
  revokedAt  DateTime @default(now()) @map("revoked_at") @db.Timestamptz(6)
  reason     String?  @db.VarChar(200)

  @@map("ota_revoked")
  @@schema("app")
}

/// 2년 미사용 정리의 하루 실행 기록(V25 리뷰 M3). 한 행뿐(CHECK id = 1 — SQL에만). 매일 storage-gc가 last_day를 오늘(UTC)로
/// 바꾸는 데 성공해야 정리를 한다 — Scheduler 재시도가 같은 날 정리를 다시 돌리지 않는다. 개수·멈춘 사유만(식별자 없음)
model InactiveSweepState {
  id         Int       @id @default(1) @db.SmallInt
  lastDay    DateTime? @map("last_day") @db.Date
  startedAt  DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)
  deleted    Int       @default(0)
  skipped    Int       @default(0)
  failed     Int       @default(0)
  candidates Int       @default(0)
  more       Boolean   @default(false)
  /// limit(하루 대상이 1%·200명 중 작은 값 초과)·clock(서버 시계가 DB 최신 활동 달보다 1달 넘게 앞섬, V25c)
  halted     String?   @db.VarChar(16)

  @@map("inactive_sweep")
  @@schema("app")
}
