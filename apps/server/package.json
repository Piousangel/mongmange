{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "몽망이 키우기 API 서버(mong-api) — NestJS + Fastify + Prisma. architecture.md v2 6절",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsup",
    "start": "node dist/main.js",
    "dev": "pnpm run build --watch --onSuccess \"node dist/main.js\"",
    "typecheck": "pnpm run prisma:generate && tsc --noEmit",
    "test": "pnpm run prisma:generate && vitest run",
    "test:db": "pnpm run prisma:generate && vitest run --config vitest.db.config.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "openapi": "pnpm run build && node dist/openapi.js",
    "check:bundle": "node scripts/check-bundle.mjs"
  },
  "dependencies": {
    "@fastify/static": "10.1.11",
    "@nestjs/common": "12.5.1",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.5.1",
    "@nestjs/platform-fastify": "12.5.1",
    "@nestjs/swagger": "12.1.2",
    "@nestjs/throttler": "6.8.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "fastify": "5.12.8",
    "nestjs-pino": "5.3.2",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@mong/contract": "workspace:*",
    "@mong/core": "workspace:*",
    "@nestjs/testing": "12.5.1",
    "@swc/core": "1.16.22",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "pino-pretty": "13.2.0",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "tsup": "9.0.0",
    "typescript": "~6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "^5.1.1"
  }
}
