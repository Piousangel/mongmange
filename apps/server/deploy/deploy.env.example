# deploy.sh 입력값 — 비밀값이 아닌 것만 둔다. 비밀값(DB 주소·키·pepper·토큰)은 여기에 쓰지 않는다(Secret Manager에 오너가 직접).
# 복사해서 저장소 밖에 둔다: mkdir -p ~/.config/mong && cp apps/server/deploy/deploy.env.example ~/.config/mong/deploy.env
# deploy.sh는 기본으로 ~/.config/mong/deploy.env를 읽는다(--env 로 바꿀 수 있음).

# GCP 프로젝트 ID와 프로젝트 번호(콘솔 첫 화면 '프로젝트 정보' 카드, 또는 gcloud projects describe <ID> --format='value(projectNumber)')
PROJECT_ID=mongmange
PROJECT_NUMBER=000000000000

# 결제 계정 ID(콘솔 > 결제 > 계정 관리, 형식 XXXXXX-XXXXXX-XXXXXX) — 예산 알림 만들 때만 쓴다
BILLING_ACCOUNT=
# 예산 금액. 결제 계정 통화로 적는다(원화 계정이면 예: 160000KRW). 알림 문턱 = 25%·50%·100%(= 30·60·120달러 — B7-report 6절)
BUDGET_AMOUNT=120USD

# Supabase 운영 프로젝트 주소(https://<ref>.supabase.co) — 비밀 아님
SUPABASE_URL=https://REPLACE.supabase.co

# 믿을 프록시 수 시작값(실측 전 가정 — B6 첫날 팀이 실측해 고친다)
HOPS_API=1
HOPS_WEB=2
HOPS_OTA=2

# 집계 핑이 받는 출시 판(쉼표)
METRIC_APP_VERSIONS=1.0

# 알림 받을 이메일(예산·업타임) — 비밀은 아니지만 저장소에는 넣지 않는다
ALERT_EMAIL=
