{
  "expo": {
    "name": "mongmangE",
    "slug": "mongmange",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://ota.mongmang.ink/api/v1/ota/manifest",
      "checkAutomatically": "ERROR_RECOVERY_ONLY",
      "fallbackToCacheTimeout": 0,
      "enableBsdiffPatchSupport": false
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.piousangel.mongmange",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "en",
        "CFBundleLocalizations": [
          "en",
          "ko"
        ],
        "CFBundleAllowMixedLocalizations": true,
        "MongAppGroup": "group.com.piousangel.mongmange"
      },
      "associatedDomains": [
        "applinks:mongmang.ink"
      ],
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.piousangel.mongmange"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.piousangel.mongmange",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "mongmang.ink",
              "pathPrefix": "/m/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "owner": "piousangels-team",
    "extra": {
      "eas": {
        "projectId": "3f2eff79-1c05-4259-85f0-bc6a59b722de"
      }
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#2B2A28"
        }
      ],
      [
        "./plugins/withSelfHostedUpdates",
        {
          "ready": false
        }
      ],
      [
        "./plugins/withAppLinks",
        {
          "appleTeamId": "",
          "androidCertSha256": []
        }
      ],
      "@bacons/apple-targets",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Mong",
              "label": "mongmangE",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "none",
              "updatePeriodMillis": 0
            }
          ]
        }
      ],
      [
        "./plugins/withInkRecognizer",
        {
          "enabled": false
        }
      ],
      "./plugins/withLowMemoryGradle",
      "./plugins/withSessionBackupExclusion"
    ]
  }
}
